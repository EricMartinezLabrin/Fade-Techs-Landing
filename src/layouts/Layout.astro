---
import '~/assets/styles/tailwind.css';

import { I18N } from 'fadetechs:config';
import { SITE } from 'fadetechs:config';
import { facebook, maps, phoneLink } from '~/data/fade';
import { getCanonical } from '~/utils/permalinks';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Comment the line below to disable View Transitions
import { ViewTransitions } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const canonical = metadata.canonical ?? String(getCanonical(Astro.url.pathname));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': 'https://fadetechs.com/#fade-technologies',
    telephone: phoneLink.slice(4),
    sameAs: [facebook],
    hasMap: maps,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Integración Social 420',
      addressLocality: 'Tampico',
      addressRegion: 'Tamaulipas',
      postalCode: '89314',
      addressCountry: 'MX',
    },
    areaServed: ['Tampico', 'Ciudad Madero', 'Altamira'].map((name) => ({ '@type': 'City', name })),
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '17:00',
    },
    name: SITE?.name ?? 'Fade Technologies',
    url: SITE?.site ?? 'https://fadetechs.com',
    logo: `${SITE?.site ?? 'https://fadetechs.com'}/logo-gold.png`,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      url: `${SITE?.site ?? 'https://fadetechs.com'}/contact`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE?.name ?? 'Fade Technologies',
    url: SITE?.site ?? 'https://fadetechs.com',
    inLanguage: language ?? 'es',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: canonical,
    about: { '@id': 'https://fadetechs.com/#fade-technologies' },
    isPartOf: SITE?.site ?? 'https://fadetechs.com',
    inLanguage: language ?? 'es',
  },
];
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Comment the line below to disable View Transitions -->
    <ViewTransitions fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-[0.01em]">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-black focus:rounded-md"
    >
      Saltar al contenido principal
    </a>
    <slot />

    <BasicScripts />
  </body>
</html>

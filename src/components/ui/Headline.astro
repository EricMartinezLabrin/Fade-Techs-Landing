---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-4xl md:text-6xl ',
  subtitle: subtitleClass = 'text-lg md:text-xl',
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge('mb-8 md:mx-auto md:mb-12 text-center', containerClass)}>
      {tagline && (
        <p
          class="inline-flex px-3 py-1.5 rounded-full border border-primary bg-primary text-sm text-black font-semibold tracking-[0.14em] uppercase"
          set:html={tagline}
        />
      )}
      {title && (
        <h2
          class={twMerge('mt-5 font-semibold leading-tight tracking-tight font-heading text-heading text-3xl', titleClass)}
          set:html={title}
        />
      )}

      {subtitle && <p class={twMerge('mt-5 text-muted max-w-2xl mx-auto', subtitleClass)} set:html={subtitle} />}
    </div>
  )
}

---
import FadeLayout from '~/layouts/FadeLayout.astro';
import CustomSolutions from '~/components/CustomSolutions.astro';
import { cities, hours, priceOf, whatsapp } from '~/data/fade';
---
<FadeLayout title="Reparación de computadoras y diseño web en Tampico" description="Reparación y mantenimiento de computadoras en Tampico, Ciudad Madero y Altamira. Desarrollo web, apps, automatización e integraciones para negocios.">
  <section class="fade-hero">
    <div class="fade-shell fade-hero-grid">
      <div>
        <p class="fade-kicker">Fade Technologies · Tampico, Tamaulipas</p>
        <h1>Reparación de computadoras y diseño web en Tampico</h1>
        <p class="fade-lead">Diagnosticamos y damos mantenimiento a computadoras. También creamos sitios web, aplicaciones y automatizaciones a medida.</p>
        <div class="fade-actions"><a class="fade-btn" href="/soporte-tecnico">Reparar mi computadora</a><a class="fade-btn secondary" href="/soluciones-digitales">Tengo un proyecto digital</a></div>
      </div>
      <img class="fade-hero-image" src="/fade-servicios.webp" alt="Ilustración de una laptop, componentes de computadora y un flujo de automatización" width="1536" height="1024" fetchpriority="high" />
    </div>
  </section>
  <section class="fade-section">
    <div class="fade-shell">
      <div class="fade-head"><p class="fade-kicker">Servicios</p><h2>¿Qué necesitas resolver?</h2></div>
      <div class="fade-grid">
        <article class="fade-card"><h3>Computadoras</h3><p>Diagnóstico, limpieza interna, formateo, respaldos, optimización y reemplazo de piezas compatibles.</p><strong class="fade-number">{priceOf('D01')} MXN</strong><p>Diagnóstico por equipo.</p><p><a href="/soporte-tecnico">Ver reparación y mantenimiento de PC</a></p></article>
        <article class="fade-card"><h3>Teléfonos y TV Android</h3><p>Optimización por software del sistema original, según el modelo y las aplicaciones que utilices.</p><strong class="fade-number">Desde {priceOf('A01')} MXN</strong><p>Optimización de teléfono Android.</p><p><a href="/soporte-tecnico#android">Ver opciones para Android</a></p></article>
        <article class="fade-card"><h3>Web, apps y automatización</h3><p>Desde una página para captar clientes hasta un sistema que conecte herramientas y reduzca trabajo manual.</p><strong class="fade-number">Desde {priceOf('W01')} MXN</strong><p>Landing page de alcance inicial.</p><p><a href="/soluciones-digitales">Ver diseño web y automatización</a></p></article>
      </div>
    </div>
  </section>
  <section class="fade-section fade-tint">
    <div class="fade-shell">
      <div class="fade-head"><p class="fade-kicker">Cómo trabajamos</p><h2>Conoce el alcance antes de decidir</h2></div>
      <ol class="fade-grid fade-steps">
        <li class="fade-card"><h3>Cuéntanos qué pasa</h3><p>Escríbenos por WhatsApp o trae tu equipo al taller dentro del horario de atención.</p></li>
        <li class="fade-card"><h3>Revisamos tu caso</h3><p>Te explicamos qué encontramos, qué opciones tienes y cuánto costaría el trabajo.</p></li>
        <li class="fade-card"><h3>Tú autorizas</h3><p>Empezamos una vez acordados el trabajo y el precio. Al terminar, revisamos el resultado contigo.</p></li>
      </ol>
    </div>
  </section>
  <section class="fade-band"><div class="fade-shell"><div><strong>Atención en {cities}</strong><p>{hours}. Recibimos equipos con o sin cita.</p></div><a class="fade-btn secondary" href={whatsapp('Hola, necesito ayuda con mi computadora.')}>Escríbenos por WhatsApp</a></div></section>
  <CustomSolutions />
</FadeLayout>

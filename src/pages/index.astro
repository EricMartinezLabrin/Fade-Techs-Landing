---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Desarrollo Web y Apps Móviles',
  ignoreTitleTemplate: true,
  description:
    'Agencia de desarrollo web y aplicaciones móviles. Creamos plataformas rápidas, escalables y optimizadas para SEO y conversión.',
  openGraph: {
    title: 'Desarrollo Web y Apps Móviles | Fade Technologies',
    description:
      'Agencia de desarrollo web y aplicaciones móviles. Creamos plataformas rápidas, escalables y optimizadas para SEO y conversión.',
    images: [{ url: '/hero.png', width: 1200, height: 630 }],
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'Solicitar propuesta', href: '/contact' },
      { text: 'Ver servicios', href: '/services' },
    ]}
    image={{ src: '/hero.png', alt: 'Equipo de desarrollo web y mobile' }}
  >
    <Fragment slot="title">
      Creamos <span class="text-accent dark:text-white highlight">productos digitales</span> que venden
    </Fragment>
    <Fragment slot="subtitle">
      Somos una agencia enfocada en programación web y aplicaciones móviles. Diseñamos, desarrollamos y optimizamos
      plataformas con alto rendimiento, buena experiencia de usuario y foco en negocio.
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Especialidad"
    title="Servicios principales"
    subtitle="Web y móvil como núcleo, con servicios complementarios para lanzar productos completos."
    items={[
      {
        title: 'Desarrollo Web a Medida',
        description: 'Sitios corporativos, e-commerce, paneles internos y plataformas SaaS con arquitectura escalable.',
        icon: 'tabler:world-www',
      },
      {
        title: 'Aplicaciones Móviles',
        description: 'Apps iOS/Android con UX sólida, APIs robustas y publicación lista para tienda.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'UX/UI de Producto',
        description: 'Diseño de flujos, interfaces y sistema visual para mejorar conversión y retención.',
        icon: 'tabler:palette',
      },
      {
        title: 'Integraciones y Automatización',
        description: 'Conectamos pasarelas de pago, CRMs, ERPs y servicios externos críticos para operación.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Modelado 3D y Activos Digitales',
        description: 'Producción visual puntual para experiencias interactivas y presentaciones técnicas.',
        icon: 'tabler:box-model-2',
      },
      {
        title: 'Soporte Evolutivo',
        description: 'Mejoras continuas, optimización de rendimiento y mantenimiento posterior al lanzamiento.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <Steps
    title="Cómo trabajamos tu proyecto"
    items={[
      {
        title: '1. Descubrimiento y estrategia',
        description: 'Definimos objetivos, alcance, arquitectura y roadmap con foco en resultados reales.',
        icon: 'tabler:search',
      },
      {
        title: '2. Diseño y prototipado',
        description: 'Construimos la experiencia de usuario y validamos antes de entrar a desarrollo.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: '3. Desarrollo e integración',
        description: 'Implementamos frontend, backend y servicios externos con buenas prácticas de ingeniería.',
        icon: 'tabler:code',
      },
      {
        title: '4. Lanzamiento y mejora continua',
        description: 'Publicación, monitoreo y optimización para escalar el producto.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80',
      alt: 'Proceso de desarrollo',
    }}
  />

  <Stats
    stats={[
      { title: 'Tiempo promedio MVP', amount: '6-10 sem' },
      { title: 'Especialistas técnicos', amount: '18' },
      { title: 'Satisfacción clientes', amount: '98%' },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: 'Hablemos de tu proyecto', href: '/contact' }]}>
    <Fragment slot="title">Desarrollo web y mobile con ejecución técnica real</Fragment>
    <Fragment slot="subtitle"
      >Cuéntanos tu idea y te devolvemos una propuesta clara de alcance, tiempos y stack.</Fragment
    >
  </CallToAction>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Precios',
  description:
    'Todos los servicios se cotizan de forma personalizada según las necesidades de tu proyecto web o móvil.',
  openGraph: {
    title: 'Precios | Fade Technologies',
    description:
      'Todos los servicios se cotizan de forma personalizada según las necesidades de tu proyecto web o móvil.',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <Features
    title="Presupuesto personalizado"
    subtitle="No trabajamos con tarifas fijas porque cada proyecto tiene objetivos, complejidad y tiempos distintos."
    columns={3}
    items={[
      {
        title: 'Alcance a medida',
        description: 'Definimos el presupuesto según funcionalidades, integraciones y objetivos de negocio.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Priorización inteligente',
        description: 'Te ayudamos a priorizar para invertir primero en lo que más impacto tendrá.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Transparencia total',
        description: 'Presentamos una propuesta clara de tiempos, entregables y costo antes de iniciar.',
        icon: 'tabler:file-description',
      },
    ]}
  />

  <CallToAction
    title="Conversemos tu proyecto y definamos el mejor presupuesto"
    subtitle="Te ayudamos a priorizar funcionalidades, tiempos e inversión para construir una propuesta clara, realista y alineada a tus metas."
    actions={[{ variant: 'primary', text: 'Contactar para cotizar', href: '/contact' }]}
  />
</Layout>

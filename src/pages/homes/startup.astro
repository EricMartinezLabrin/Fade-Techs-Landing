---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Landing para startups',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Soluciones para startups"
    actions={[
      { variant: 'primary', text: 'Solicitar propuesta', href: '/contact', icon: 'tabler:download' },
      { text: 'Ver capacidades', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      Impulsa la presencia digital de tu <span class="text-accent dark:text-white highlight">startup</span> con desarrollo
      web y móvil orientado a resultados
    </Fragment>

    <Fragment slot="subtitle">
      Diseñamos productos digitales que ayudan a validar más rápido, atraer clientes y convertir oportunidades con una base
      técnica lista para escalar.
    </Fragment>
  </Hero>

  <Features2
    title="Quiénes somos"
    subtitle="Somos un equipo de desarrollo y diseño enfocado en crear sitios web, apps móviles y plataformas digitales para negocios en crecimiento."
  />

  <Stats
    title="Impacto en proyectos digitales"
    subtitle="Estos resultados reflejan el valor que generamos en productos web y móviles."
    stats={[
      { title: 'Proyectos entregados', amount: '180+' },
      { title: 'Lanzamientos exitosos', amount: '87' },
      { title: 'Calificación promedio', amount: '4.8' },
      { title: 'Clientes satisfechos', amount: '116+' },
    ]}
  />

  <Features2
    title="Servicios principales"
    subtitle="Combinamos estrategia, UX/UI y desarrollo para construir productos coherentes con tus objetivos de negocio."
    items={[
      {
        title: 'Desarrollo web a medida',
        description: 'Sitios corporativos, landings y plataformas optimizadas para conversión y SEO técnico.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Desarrollo de apps móviles',
        description: 'Aplicaciones iOS y Android con enfoque en rendimiento, usabilidad e integración con backend.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Soporte técnico y evolución',
        description: 'Acompañamiento continuo para mejoras, nuevas funciones y estabilidad post-lanzamiento.',
        icon: 'flat-color-icons:voice-presentation',
      },
    ]}
  />

  <Features
    id="features"
    title="Características de nuestras soluciones"
    subtitle="Elementos clave para construir productos digitales sólidos y competitivos."
    columns={3}
    items={[
      {
        title: 'Diseño moderno y profesional',
        description: 'Interfaces alineadas a tu marca y a expectativas actuales de usuarios digitales.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Experiencia responsive',
        description: 'Funcionamiento consistente en escritorio, tablet y móvil.',
        icon: 'tabler:picture-in-picture',
      },
      {
        title: 'Personalización por negocio',
        description: 'Contenido, flujos y funcionalidades adaptadas a tu operación real.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Alto rendimiento',
        description: 'Arquitectura optimizada para tiempos de carga rápidos y buena estabilidad.',
        icon: 'tabler:rocket',
      },
      {
        title: 'SEO técnico',
        description: 'Estructura semántica y buenas prácticas para facilitar indexación y visibilidad.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Integración y compatibilidad',
        description: 'Conexión con APIs, herramientas de negocio y ecosistemas existentes.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

  <FAQs
    title="Preguntas frecuentes"
    items={[
      {
        title: '¿Trabajan solo con startups?',
        description: 'No. También colaboramos con pymes y empresas que buscan modernizar su presencia digital.',
      },
      {
        title: '¿Pueden desarrollar web y app móvil en el mismo proyecto?',
        description: 'Sí. Diseñamos ambos frentes para mantener consistencia técnica y de experiencia.',
      },
      {
        title: '¿Cuánto tarda un proyecto?',
        description: 'Depende del alcance. Definimos tiempos y entregables desde la fase de descubrimiento.',
      },
      {
        title: '¿Incluyen soporte después de publicar?',
        description: 'Sí. Ofrecemos mantenimiento y mejoras continuas según necesidades del negocio.',
      },
    ]}
  />

  <Features3
    title="Estamos para ayudarte"
    subtitle="Cuéntanos tu objetivo y te proponemos el siguiente paso con una ruta clara."
    columns={4}
    items={[
      {
        title: 'Teléfono',
        icon: 'tabler:phone',
        callToAction: { text: 'Llamarnos', href: '/contact', variant: 'link' },
      },
      {
        title: 'Correo',
        icon: 'tabler:mail',
        callToAction: { text: 'Escribirnos', href: '/contact', variant: 'link' },
      },
      {
        title: 'Ventas',
        icon: 'tabler:message-circle',
        callToAction: { text: 'Hablar con ventas', href: '/contact', variant: 'link' },
      },
      {
        title: 'Soporte',
        icon: 'tabler:message-circle',
        callToAction: { text: 'Hablar con soporte', href: '/contact', variant: 'link' },
      },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Iniciar proyecto', href: '/contact', icon: 'tabler:download' },
    ]}
  >
    <Fragment slot="title">Construyamos tu próximo producto digital</Fragment>
    <Fragment slot="subtitle">Unimos estrategia y ejecución para convertir ideas en resultados reales.</Fragment>
  </CallToAction>
</Layout>

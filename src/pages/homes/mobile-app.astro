---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

import { headerData } from '~/navigation';

const metadata = {
  title: 'Aplicación móvil',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Soluciones móviles para tu negocio"
    image={{
      src: 'https://images.unsplash.com/photo-1535303311164-664fc9ec6532?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Equipo de desarrollo móvil de Fade Technologies',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white highlight">Desarrollo de apps móviles</span>: <br /> iOS y Android
      <span class="hidden xl:inline"> alineadas con tu web y tus objetivos</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Desbloquea nuevas posibilidades para tu producto digital desde una sola plataforma.
      </span>
      Acelera la ejecución de tus proyectos móviles con una estrategia técnica clara.
    </Fragment>
  </Hero2>

  <!-- Features3 Widget ************** -->

  <Features3
    id="features"
    title="¿Cómo trabajamos tu app móvil?"
    subtitle="Convertimos tu idea en una aplicación sólida y escalable, conectada con tus sistemas actuales y pensada para el crecimiento real de tu negocio."
    tagline="Proceso de desarrollo"
    columns={2}
    items={[
      {
        title: 'Descubrimiento y estrategia',
        description: `Definimos alcance, funcionalidades clave, público objetivo y hoja de ruta técnica para construir una app móvil con impacto.`,
        icon: 'tabler:square-number-1',
      },
      {
        title: 'UX/UI y arquitectura',
        description:
          'Diseñamos flujos claros y una interfaz moderna; al mismo tiempo estructuramos backend, APIs y base de datos para rendimiento y seguridad.',
        icon: 'tabler:square-number-2',
      },
      {
        title: 'Desarrollo y pruebas',
        description: 'Implementamos la app con buenas prácticas, pruebas funcionales y control de calidad en distintos dispositivos.',
        icon: 'tabler:square-number-3',
      },
      {
        title: 'Lanzamiento y mejora continua',
        description: `Publicamos en tiendas, monitoreamos métricas y evolucionamos el producto con nuevas funcionalidades según resultados reales.`,
        icon: 'tabler:square-number-4',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521517407911-565264e7d82d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2069&q=80',
      alt: 'Proceso de desarrollo móvil',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Experiencia de usuario intuitiva',
        description:
          'Diseñamos interfaces claras, rápidas y accesibles para que tus usuarios completen tareas sin fricción.',
        icon: 'tabler:wand',
      },
      {
        title: 'Funcionalidades personalizadas',
        description:
          'Construimos módulos a medida según tu operación: catálogos, reservas, pagos, paneles y automatizaciones.',
        icon: 'tabler:settings',
      },
      {
        title: 'Integración con tu ecosistema',
        description:
          'Conectamos tu app con CRM, ERP, APIs de terceros, pasarelas de pago y servicios de notificación.',
        icon: 'tabler:template',
      },
      {
        title: 'Escalabilidad técnica',
        description: 'Preparamos una base sólida para soportar crecimiento de usuarios, nuevas funciones y alto rendimiento.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Características principales de apps móviles',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Beneficios principales</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Modo sin conexión',
        description: 'Implementamos funciones críticas que continúan operando incluso con conectividad limitada.',
        icon: 'tabler:wifi-off',
      },
      {
        title: 'Datos seguros en la nube',
        description:
          'Protegemos la información con almacenamiento cifrado, respaldos y buenas prácticas de seguridad.',
        icon: 'tabler:file-download',
      },
      {
        title: 'Evolución constante',
        description: 'Mantenemos tu app al día con mejoras, optimizaciones y nuevas funcionalidades basadas en datos.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Analítica y decisiones',
        description: `Configuramos métricas de uso y eventos para que puedas tomar decisiones de producto con evidencia.`,
        icon: 'tabler:heart',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Servicios complementarios para apps móviles',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Servicios complementarios</h3>
    </Fragment>
  </Content>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Resultados típicos en proyectos móviles"
    stats={[
      { amount: '+120', icon: 'tabler:devices' },
      { amount: '+95%', icon: 'tabler:users' },
      { amount: '4.9/5', icon: 'tabler:user-star' },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo que opinan nuestros usuarios"
    testimonials={[
      {
        testimonial:
          'Pasamos de una idea a una app publicada en tiempo récord. El equipo propuso mejoras clave en UX y hoy tenemos más conversión en móvil.',
        name: 'Cary Kennedy',
        job: 'Directora de producto',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Testimonio de Cary Kennedy',
        },
      },
      {
        testimonial:
          'Integraron nuestra app con el backend y los procesos internos sin afectar la operación. Ahora todo está centralizado y medible.',
        name: 'Josh Wilkinson',
        job: 'Gerente de operaciones',
        image: {
          src: 'https://images.unsplash.com/flagged/photo-1570612861542-284f4c12e75f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Testimonio de Josh Wilkinson',
        },
      },
      {
        testimonial:
          'La calidad técnica y la comunicación fueron excelentes. Nos entregaron una app rápida, estable y lista para escalar.',
        name: 'Sidney Hansen',
        job: 'Fundador de startup',
        image: {
          src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Testimonio de Sidney Hansen',
        },
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="¿Aún tienes dudas?"
    items={[
      {
        title: '¿Qué hace esta app?',
        description:
          'Esta sección presenta cómo diseñamos y desarrollamos apps móviles a medida para empresas que buscan crecer en canales digitales.',
      },
      {
        title: '¿Cómo resuelve mi problema?',
        description:
          'Creamos una solución centrada en tu operación: optimiza procesos, mejora la experiencia del cliente y genera resultados medibles.',
      },
      {
        title: '¿Está disponible para mi dispositivo?',
        description:
          'Desarrollamos para iOS y Android, con enfoque adaptable y compatibilidad con distintas resoluciones y versiones modernas.',
      },
      {
        title: '¿Qué la hace diferente?',
        description:
          'Combinamos estrategia de negocio, diseño UX/UI y arquitectura técnica para entregar apps funcionales, escalables y alineadas con tu web.',
      },
      {
        title: '¿Tiene costos?',
        description:
          'Cada proyecto se cotiza según alcance, funcionalidades e integraciones. Te entregamos propuesta clara antes de iniciar.',
      },
    ]}
  />

</Layout>



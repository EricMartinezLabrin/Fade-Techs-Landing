---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';
import { headerData } from '~/navigation';

const metadata = {
  title: 'Perfil profesional',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme />
  </Fragment>

  <Hero
    id="hero"
    title="Sarah Johnson"
    tagline="Perfil profesional"
    actions={[{ variant: 'primary', text: 'Iniciar proyecto', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      Soy diseñadora digital enfocada en experiencia de usuario para productos web y móviles. Transformo objetivos de
      negocio en interfaces claras, funcionales y visualmente memorables.
    </Fragment>
  </Hero>

  <Content
    id="about"
    columns={3}
    items={[
      { icon: 'tabler:brand-dribbble', callToAction: { text: 'Dribbble', href: '/contact' } },
      { icon: 'tabler:brand-behance', callToAction: { text: 'Behance', href: '/contact' } },
      { icon: 'tabler:brand-pinterest', callToAction: { text: 'Pinterest', href: '/contact' } },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Perfil profesional de diseño digital',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>
      <p>
        Trabajo en proyectos donde diseño y desarrollo se conectan para crear productos consistentes en web y app móvil.
        Mi enfoque combina investigación, estructura de contenido y prototipado orientado a conversión.
      </p>
      <br />
      <p>
        Me interesa construir soluciones digitales que sean útiles para usuarios reales y sostenibles para equipos de
        negocio y tecnología.
      </p>
    </Fragment>
  </Content>

  <Steps
    id="resume"
    title="Experiencia"
    items={[
      {
        title:
          'Diseñadora de producto digital <br /> <span class="font-normal">ABC Studio, Nueva York</span> <br /> <span class="text-sm font-normal">2021 - Actualidad</span>',
        description:
          'Diseño de interfaces para plataformas SaaS, apps móviles y sitios corporativos. Colaboración constante con equipos de desarrollo para validar usabilidad y viabilidad técnica.',
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Diseñadora visual junior <br /> <span class="font-normal">XYZ Creative Agency, Los Ángeles</span> <br /> <span class="text-sm font-normal">2018 - 2021</span>',
        description:
          'Participación en proyectos de branding y campañas digitales. Creación de piezas visuales y apoyo en sistemas de diseño para productos web.',
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <Features3
    title="Habilidades"
    subtitle="Competencias clave para diseño y producto digital."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      { title: 'Diseño de interfaces', description: 'Sistemas visuales claros para web y móvil.' },
      { title: 'Branding digital', description: 'Identidad visual coherente con objetivos de negocio.' },
      { title: 'UX centrada en usuario', description: 'Flujos simples, accesibles y orientados a tareas.' },
      { title: 'Prototipado', description: 'Validación rápida de ideas antes de desarrollo.' },
      { title: 'Tipografía y color', description: 'Jerarquía visual para mejorar lectura y comprensión.' },
      { title: 'Diseño responsive', description: 'Experiencia consistente en múltiples dispositivos.' },
      { title: 'Colaboración con desarrollo', description: 'Trabajo conjunto para asegurar viabilidad técnica.' },
      { title: 'Atención al detalle', description: 'Control de calidad visual y funcional en entregables.' },
      { title: 'Adaptabilidad', description: 'Ajuste continuo a contexto, equipo y objetivos.' },
    ]}
  />

  <Content
    id="portfolio"
    title="Proyectos destacados"
    subtitle="Casos donde combiné estrategia, diseño y producto para resolver retos de negocio."
    isReversed
    items={[
      {
        title: 'Contexto',
        description: 'Identidad digital para startup tecnológica con necesidad de posicionamiento rápido y coherencia de marca.',
      },
      {
        title: 'Rol',
        description:
          'Lideré el proceso de diseño visual y lineamientos de interfaz para web, panel administrativo y activos de comunicación.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
      alt: 'Proyecto de identidad digital',
    }}
    callToAction={{ text: 'Ver proyecto', icon: 'tabler:chevron-right', href: '/contact' }}
  />

  <Testimonials
    title="Testimonios"
    subtitle="Opiniones de clientes con quienes colaboré en proyectos digitales."
    testimonials={[
      {
        testimonial:
          'Transformó una idea ambigua en una experiencia clara y funcional. El resultado mejoró nuestra conversión desde el primer mes.',
        name: 'Mark Thompson',
        job: 'Director creativo',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Testimonio de Mark Thompson',
        },
      },
      {
        testimonial:
          'Alineó perfectamente diseño, marca y objetivos comerciales. Su trabajo elevó la percepción de nuestro producto.',
        name: 'Emily Martinez',
        job: 'CEO',
        image: {
          src: 'https://images.unsplash.com/photo-1554151228-14d9def656e4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=772&q=80',
          alt: 'Testimonio de Emily Martinez',
        },
      },
    ]}
  />

  <CallToAction
    title="Diseñemos algo grande"
    subtitle="Si quieres una experiencia digital sólida para web o móvil, conversemos."
    actions={[{ variant: 'primary', text: 'Contáctame', href: '/contact' }]}
  />

  <BlogLatestPosts
    id="blog"
    title="Artículos sobre diseño y producto digital"
    information={`Comparto aprendizajes prácticos sobre UX/UI, estrategia de producto y colaboración entre diseño y desarrollo.`}
  />
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Solución SaaS',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      {...headerData}
      actions={[
        { variant: 'secondary', text: 'Iniciar sesión', href: '/contact' },
        { variant: 'primary', text: 'Solicitar demo', href: '/contact' },
      ]}
      isSticky
    />
  </Fragment>

  <Hero2
    tagline="Plataforma SaaS"
    actions={[
      { variant: 'primary', text: 'Solicitar propuesta', href: '/contact' },
      { text: 'Ver capacidades', href: '#features' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1580481072645-022f9a6dbf27?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Equipo desarrollando plataforma SaaS',
    }}
  >
    <Fragment slot="title">
      Software <span class="text-accent dark:text-white highlight">SaaS</span> a medida para digitalizar procesos y escalar
      tu operación
    </Fragment>
    <Fragment slot="subtitle">
      Diseñamos y desarrollamos productos SaaS con arquitectura robusta, experiencia de usuario clara e integraciones que
      conectan tu negocio de punta a punta.
    </Fragment>
  </Hero2>

  <Features
    id="features"
    title="¿Por qué elegir esta solución SaaS?"
    subtitle="Combinamos diseño, ingeniería y estrategia para crear plataformas que sí se usan y generan resultados."
    columns={2}
    items={[
      {
        title: 'Arquitectura escalable',
        description: 'Estructura preparada para crecer en usuarios, módulos y carga sin comprometer rendimiento.',
        icon: 'tabler:layers-union',
      },
      {
        title: 'UX enfocada en productividad',
        description: 'Flujos claros para reducir fricción operativa y acelerar tareas clave del equipo.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Integraciones estratégicas',
        description: 'Conectamos tu SaaS con CRM, ERP, pagos, analítica, mensajería y APIs de terceros.',
        icon: 'tabler:writing',
      },
      {
        title: 'Automatización de procesos',
        description: 'Reducimos tareas manuales con reglas, eventos y notificaciones configurables.',
        icon: 'tabler:podium',
      },
      {
        title: 'SEO técnico y performance',
        description: 'Base optimizada para velocidad, indexación y estabilidad en buscadores.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Código mantenible',
        description: 'Buenas prácticas de desarrollo para facilitar evolución, soporte y nuevas funcionalidades.',
        icon: 'tabler:eyeglass',
      },
    ]}
  />

  <Content
    title="Casos de uso"
    subtitle="Adaptamos la plataforma según tu modelo de negocio y etapa de crecimiento."
    isReversed
    items={[
      {
        title: 'Startups de alto crecimiento',
        description: 'Construimos MVPs y versiones productivas con foco en validación rápida, métricas y escalabilidad.',
      },
      {
        title: 'Beneficios',
        description: 'Salida al mercado más rápida, mejor experiencia de usuario y base técnica lista para escalar.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1620558138198-cfb9b4f3c294?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1671&q=80',
      alt: 'Equipo startup trabajando en su SaaS',
    }}
  />

  <Content
    isAfterContent={true}
    items={[
      {
        title: 'Empresas en transformación digital',
        description: 'Modernizamos herramientas internas y portales de clientes con una experiencia consistente y segura.',
      },
      {
        title: 'Beneficios',
        description: 'Mayor control operativo, menor carga manual y mejor trazabilidad de la información.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1658&q=80',
      alt: 'Empresa usando software SaaS',
    }}
  />

  <Pricing
    title="Planes de desarrollo"
    prices={[
      {
        title: 'Inicial',
        subtitle: 'Ideal para validar producto',
        price: '0',
        period: '/ diagnóstico',
        callToAction: { text: 'Solicitar evaluación', href: '/contact' },
      },
      {
        title: 'Profesional',
        subtitle: 'Producto SaaS con módulos clave',
        price: 15,
        period: '/ plan base',
        callToAction: { text: 'Cotizar proyecto', href: '/contact' },
        hasRibbon: true,
        ribbonTitle: 'recomendado',
      },
      {
        title: 'Enterprise',
        subtitle: 'Solución para operación compleja',
        price: 45,
        period: '/ plan avanzado',
        callToAction: { text: 'Hablar con un especialista', href: '/contact' },
      },
    ]}
  />

  <FAQs
    title="Preguntas frecuentes"
    items={[
      {
        title: '¿Pueden desarrollar solo el frontend o también backend?',
        description: 'Podemos trabajar por capas o entregar una solución completa según tus necesidades.',
        icon: 'tabler:chevrons-right',
      },
      {
        title: '¿El sistema puede integrarse con herramientas actuales?',
        description: 'Sí. Definimos e implementamos integraciones con tus sistemas y servicios externos.',
        icon: 'tabler:chevrons-right',
      },
      {
        title: '¿Cómo manejan seguridad y privacidad?',
        description: 'Aplicamos controles de acceso y prácticas seguras desde el diseño.',
        icon: 'tabler:chevrons-right',
      },
      {
        title: '¿Ofrecen soporte posterior al lanzamiento?',
        description: 'Sí. Incluimos soporte evolutivo y mantenimiento.',
        icon: 'tabler:chevrons-right',
      },
    ]}
  />

  <Steps2
    title="Conversemos sobre tu SaaS"
    subtitle="Cuéntanos tu objetivo y te proponemos una ruta técnica realista para construirlo."
    callToAction={{ text: 'Contáctanos', href: '/contact' }}
    items={[
      { title: 'Correo', description: 'contacto@fadetechs.com', icon: 'tabler:mail' },
      { title: 'Llamada', description: '+52 55 0000 0000', icon: 'tabler:headset' },
      { title: 'Redes', description: '@fadetechs', icon: 'tabler:brand-x' },
    ]}
  />

  <BlogLatestPosts
    id="blog"
    title="Guías y tendencias para productos SaaS"
    information={`Publicamos contenido sobre arquitectura, UX, desarrollo web y móvil para equipos que construyen productos digitales escalables.`}
  />
</Layout>

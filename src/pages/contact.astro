---
import Layout from '~/layouts/PageLayout.astro';
import Contact from '~/components/widgets/Contact.astro';
const status = Astro.url.searchParams.get('status');
const statusMessage =
  status === 'ok'
    ? 'Gracias. Recibimos tu mensaje y te responderemos en breve.'
    : status === 'error'
      ? 'No pudimos enviar tu mensaje. Inténtalo de nuevo en unos minutos.'
      : 'Te responderemos por correo en menos de 24 horas hábiles.';

const metadata = {
  title: 'Contacto',
  description:
    'Solicita una propuesta para tu proyecto web o app móvil. Te ayudamos a definir alcance, stack técnico y tiempos de entrega.',
  openGraph: {
    title: 'Contacto | Fade Technologies',
    description:
      'Solicita una propuesta para tu proyecto web o app móvil. Te ayudamos a definir alcance, stack técnico y tiempos de entrega.',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <Contact
    title="Hablemos de tu proyecto web o móvil"
    subtitle="Cuéntanos qué quieres construir. Te responderemos con una propuesta de alcance, tiempos y presupuesto. También puedes escribir directamente a eric@fadetechs.com."
    inputs={[
      { type: 'text', name: 'name', autocomplete: 'given-name', placeholder: 'Nombre' },
      { type: 'email', name: 'email', autocomplete: 'email', placeholder: 'Correo electrónico' },
    ]}
    textarea={{ name: 'message', placeholder: 'Describe tu proyecto', rows: 6 }}
    button='Enviar solicitud'
    description={statusMessage}
    action="/api/contact"
    method="post"
    disclaimer={{ label: 'Al enviar este formulario aceptas que te contactemos para dar seguimiento a tu solicitud.' }}
  />
</Layout>


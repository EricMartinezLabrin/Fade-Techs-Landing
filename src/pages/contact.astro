---
import FadeLayout from '~/layouts/FadeLayout.astro';
import { address, cities, email, facebook, hours, maps, phone, phoneLink, whatsapp } from '~/data/fade';
---
<FadeLayout title="Contacto y horario del taller en Tampico" description="Contacta a Fade Technologies por WhatsApp o visita el taller de computadoras en Tampico. Recibimos equipos con o sin cita.">
  <section class="fade-hero"><div class="fade-shell"><p class="fade-kicker">Contacto · {cities}</p><h1>Contacto y horario del taller en Tampico</h1><p class="fade-lead">Puedes escribirnos para cotizar o venir a dejar tu computadora dentro del horario de atención.</p></div></section>
  <section class="fade-section"><div class="fade-shell fade-grid two contact-cards">
    <article class="fade-card contact-card">
      <div class="contact-details">
      <h2>Visita el taller</h2>
      <p>{address}</p><p>{hours}. Recibimos equipos con o sin cita.</p>
      </div>
      <div class="contact-footer">
        <div class="fade-actions"><a class="fade-btn" href={maps}>Cómo llegar al taller</a><a class="fade-btn secondary" href={whatsapp('Hola, quiero consultar por un servicio en el taller.')}>WhatsApp</a></div>
        <p><a href={phoneLink}>{phone}</a> · <a href={facebook}>Facebook</a></p>
      </div>
    </article>
    <article class="fade-card contact-card">
      <div class="contact-details">
      <h2>Escríbenos directamente</h2>
      <p>Cuéntanos por WhatsApp o correo electrónico qué problema tiene tu equipo o qué proyecto quieres cotizar.</p>
      </div>
      <div class="contact-footer">
        <div class="fade-actions">
          <a class="fade-btn" href={whatsapp('Hola, quiero cotizar un servicio con Fade Technologies.')}>WhatsApp</a>
          <a class="fade-btn secondary" href={`mailto:${email}`}>Correo electrónico</a>
        </div>
        <p><a href={`mailto:${email}`}>{email}</a></p>
      </div>
    </article>
  </div></section>
</FadeLayout>

<style>
  .contact-cards {
    gap: 1.5rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .contact-card h2 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    line-height: 1.2;
    letter-spacing: -.025em;
    margin-bottom: 1rem;
  }

  .contact-footer {
    margin-top: auto;
    display: grid;
    gap: 1rem;
  }

  .contact-footer .fade-actions {
    margin-top: 0;
  }

  .contact-footer p {
    overflow-wrap: anywhere;
    font-size: .95rem;
  }

  @media (max-width: 760px) {
    .contact-cards {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 380px) {
    .contact-footer .fade-actions {
      flex-direction: column;
    }
  }
</style>

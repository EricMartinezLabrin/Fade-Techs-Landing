---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Nosotros',
  description:
    'Equipo especializado en desarrollo web y mobile. Combinamos estrategia, diseño y tecnología para construir productos digitales de alto impacto.',
  openGraph: {
    title: 'Nosotros | Fade Technologies',
    description:
      'Equipo especializado en desarrollo web y mobile. Combinamos estrategia, diseño y tecnología para construir productos digitales de alto impacto.',
  },
  twitter: {
    cardType: 'summary_large_image',
  },
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Nosotros"
    title="Equipo técnico enfocado en producto digital"
    subtitle="Combinamos estrategia, diseño y desarrollo para construir plataformas web y móviles con impacto real."
    actions={[{ variant: 'primary', text: 'Conversemos', href: '/contact' }]}
  />

  <Content
    items={[
      { title: 'Visión de negocio', description: 'Cada decisión técnica responde a objetivos comerciales medibles.' },
      { title: 'Rigor de ingeniería', description: 'Arquitecturas mantenibles, código limpio y despliegues confiables.' },
      { title: 'Ejecución colaborativa', description: 'Trabajamos contigo como equipo extendido, con comunicación continua.' },
    ]}
    image={{ src: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80', alt: 'Equipo' }}
  >
    <Fragment slot="content">
      Construimos productos digitales para startups y empresas que necesitan velocidad de ejecución sin comprometer calidad.
    </Fragment>
  </Content>

  <Features2
    id="uiux-producto"
    title="UI/UX y Producto"
    subtitle="Diseñamos experiencias digitales útiles, claras y rentables. El objetivo no es solo que se vea bien: es que funcione mejor para tus usuarios y para tu negocio."
    columns={3}
    items={[
      {
        title: 'Descubrimiento y estrategia',
        description: 'Investigamos usuarios, objetivos y fricciones para definir prioridades reales de producto.',
        icon: 'tabler:search',
      },
      {
        title: 'Arquitectura y flujos',
        description: 'Ordenamos información y recorridos clave para reducir fricción y mejorar conversión.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Diseño de interfaz',
        description: 'Creamos pantallas consistentes, accesibles y alineadas con tu identidad de marca.',
        icon: 'tabler:layout',
      },
      {
        title: 'Prototipado y validación',
        description: 'Probamos hipótesis antes de desarrollar para minimizar retrabajo y riesgo técnico.',
        icon: 'tabler:route',
      },
      {
        title: 'Sistema de diseño',
        description: 'Definimos componentes reutilizables para escalar web y app móvil con coherencia.',
        icon: 'tabler:layers-subtract',
      },
      {
        title: 'Medición y evolución',
        description: 'Analizamos métricas de uso para iterar producto y mejorar resultados continuamente.',
        icon: 'tabler:chart-line',
      },
    ]}
  />

  <CallToAction
    title="¿Quieres mejorar la experiencia de tu producto?"
    subtitle="Conversemos sobre tu proyecto y armemos una ruta de UI/UX y producto ajustada a tus necesidades."
    actions={[{ variant: 'primary', text: 'Hablar con el equipo', href: '/contact' }]}
  />
</Layout>

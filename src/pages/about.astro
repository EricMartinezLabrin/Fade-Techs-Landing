---
import FadeLayout from '~/layouts/FadeLayout.astro';
import { cities, hours } from '~/data/fade';
---
<FadeLayout title="Acerca de Fade Technologies" description="Taller de soporte para computadoras y servicios de desarrollo y automatización en Tampico.">
  <section class="fade-hero"><div class="fade-shell"><p class="fade-kicker">Acerca de nosotros</p><h1>Fade Technologies</h1><p class="fade-lead">Atendemos computadoras en {cities} y desarrollamos sitios web, aplicaciones y automatizaciones para negocios.</p></div></section>
  <section class="fade-section"><div class="fade-shell fade-grid two"><article class="fade-card"><h2>Atención en taller</h2><p>{hours}. Puedes agendar o dejar tu equipo sin cita.</p><a href="/contact">Ver contacto y ubicación</a></article><article class="fade-card"><h2>Trabajo con alcance claro</h2><p>Explicamos el diagnóstico o los entregables y confirmamos el presupuesto antes de empezar.</p><a href="/services">Conocer los servicios</a></article></div></section>
</FadeLayout>
